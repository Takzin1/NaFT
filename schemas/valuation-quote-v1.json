{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:naft:environmental-valuation:1",
  "type": "object",
  "properties": {
    "schema": {
      "const": "naft-environmental-valuation/1"
    },
    "calculation_version": {
      "const": "1.0.0"
    },
    "mode": {
      "const": "SIMULATION_ONLY"
    },
    "classification": {
      "const": "RESEARCH_SCENARIO_ONLY"
    },
    "formal_certification": {
      "const": false
    },
    "certified_quantity": {
      "const": null
    },
    "label": {
      "const": "仮定に基づく参考値"
    },
    "as_of": {
      "$ref": "#/$defs/timestamp"
    },
    "previous_receipt_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "object",
          "properties": {
            "asset_id": {
              "$ref": "#/$defs/text"
            },
            "asset_category": {
              "$ref": "#/$defs/text"
            },
            "methodology_id": {
              "$ref": "#/$defs/text"
            },
            "methodology_version": {
              "$ref": "#/$defs/text"
            },
            "evidence_package_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "source_record_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "verification_status": {
              "$ref": "#/$defs/text"
            },
            "quantity": {
              "anyOf": [
                {
                  "$ref": "#/$defs/decimal"
                },
                {
                  "type": "null"
                }
              ]
            },
            "quantity_unit": {
              "$ref": "#/$defs/text"
            },
            "rights_status": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "asset_id",
            "asset_category",
            "methodology_id",
            "methodology_version",
            "evidence_package_sha256",
            "source_record_sha256",
            "verification_status",
            "quantity",
            "quantity_unit",
            "rights_status"
          ],
          "additionalProperties": false
        },
        "valuation_scenario_id": {
          "$ref": "#/$defs/text"
        },
        "snapshot": {
          "type": "object",
          "properties": {
            "price": {
              "anyOf": [
                {
                  "$ref": "#/$defs/observation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "fx": {
              "anyOf": [
                {
                  "$ref": "#/$defs/observation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "peg": {
              "anyOf": [
                {
                  "$ref": "#/$defs/observation"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "price",
            "fx",
            "peg"
          ],
          "additionalProperties": false
        },
        "asset_symbol": {
          "$ref": "#/$defs/symbol"
        },
        "fee_bps": {
          "$ref": "#/$defs/decimal"
        },
        "quantity_override": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "asset",
        "valuation_scenario_id",
        "snapshot",
        "asset_symbol",
        "fee_bps",
        "quantity_override"
      ],
      "additionalProperties": false
    },
    "states": {
      "type": "object",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/text"
        },
        "price": {
          "$ref": "#/$defs/text"
        },
        "fx": {
          "$ref": "#/$defs/text"
        },
        "peg": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "evidence",
        "price",
        "fx",
        "peg"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "VALID",
        "BLOCKED"
      ]
    },
    "quote": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "eligible_quantity": {
              "$ref": "#/$defs/decimal"
            },
            "assumed_unit_price_jpy": {
              "$ref": "#/$defs/decimal"
            },
            "reference_value_jpy": {
              "$ref": "#/$defs/decimal"
            },
            "fx_principal_jpy": {
              "$ref": "#/$defs/decimal"
            },
            "reference_value_usd": {
              "$ref": "#/$defs/decimal"
            },
            "fx_rate": {
              "$ref": "#/$defs/decimal"
            },
            "peg_reference": {
              "$ref": "#/$defs/decimal"
            },
            "gross_amount": {
              "$ref": "#/$defs/decimal"
            },
            "estimated_fee": {
              "$ref": "#/$defs/decimal"
            },
            "net_amount": {
              "$ref": "#/$defs/decimal"
            },
            "quantity_unit": {
              "const": "tCO2e"
            },
            "quantity_basis": {
              "enum": [
                "SOURCE_ESTIMATE",
                "SCENARIO_OVERRIDE"
              ]
            },
            "price_source": {
              "$ref": "#/$defs/text"
            },
            "price_observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "price_as_of": {
              "$ref": "#/$defs/timestamp"
            },
            "base_currency": {
              "const": "JPY"
            },
            "quote_currency": {
              "enum": [
                "USD",
                "JPY"
              ]
            },
            "asset_symbol": {
              "$ref": "#/$defs/symbol"
            },
            "issuer_reference": {
              "$ref": "#/$defs/text"
            },
            "reference_decimals": {
              "const": 6
            },
            "fx_source": {
              "$ref": "#/$defs/text"
            },
            "fx_timestamp": {
              "$ref": "#/$defs/timestamp"
            },
            "peg_source": {
              "$ref": "#/$defs/text"
            },
            "peg_timestamp": {
              "$ref": "#/$defs/timestamp"
            },
            "rounding_policy": {
              "const": "FLOOR_JPY_THEN_FLOOR_MICRO_UNITS_AND_FEE"
            },
            "quote_expiry": {
              "$ref": "#/$defs/timestamp"
            },
            "network_reference": {
              "const": "UNKNOWN"
            },
            "chain_id": {
              "const": "UNKNOWN"
            },
            "token_contract_reference": {
              "const": "UNKNOWN"
            },
            "token_decimals": {
              "const": "UNKNOWN"
            }
          },
          "required": [
            "eligible_quantity",
            "assumed_unit_price_jpy",
            "reference_value_jpy",
            "fx_principal_jpy",
            "reference_value_usd",
            "fx_rate",
            "peg_reference",
            "gross_amount",
            "estimated_fee",
            "net_amount",
            "quantity_unit",
            "quantity_basis",
            "price_source",
            "price_observed_at",
            "price_as_of",
            "base_currency",
            "quote_currency",
            "asset_symbol",
            "issuer_reference",
            "reference_decimals",
            "fx_source",
            "fx_timestamp",
            "peg_source",
            "peg_timestamp",
            "rounding_policy",
            "quote_expiry",
            "network_reference",
            "chain_id",
            "token_contract_reference",
            "token_decimals"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schema",
    "calculation_version",
    "mode",
    "classification",
    "formal_certification",
    "certified_quantity",
    "label",
    "as_of",
    "previous_receipt_sha256",
    "input",
    "states",
    "status",
    "quote",
    "receipt_sha256"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$",
      "maxLength": 40
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "symbol": {
      "enum": [
        "SIM-USD",
        "USDC",
        "JPYC"
      ]
    },
    "observation": {
      "type": "object",
      "properties": {
        "pair": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "type": "string",
          "maxLength": 256
        },
        "source_kind": {
          "$ref": "#/$defs/text"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "as_of": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "market_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "fixed_redemption_value": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_assumption": {
          "anyOf": [
            {
              "$ref": "#/$defs/decimal"
            },
            {
              "type": "null"
            }
          ]
        },
        "selected": {
          "enum": [
            "market_price",
            "user_assumption"
          ]
        },
        "conflicting": {
          "type": "boolean"
        }
      },
      "required": [
        "pair",
        "source",
        "source_kind",
        "observed_at",
        "as_of",
        "expires_at",
        "market_price",
        "fixed_redemption_value",
        "user_assumption",
        "selected",
        "conflicting"
      ],
      "additionalProperties": false
    }
  }
}
